{
  "name": "twitter-quote-bot",
  "type": "module",
  "version": "1.0.0",
  "description": "A Discord bot to quote tweet.",
  "author": "otoneko.",
  "license": "Apache-2.0",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "format": "prettier --write ./src ./tests",
    "format:check": "prettier --check ./src ./tests",
    "lint": "",
    "lint:fix": "",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "fix": "npm run format && npm run lint:fix"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "discord.js": "^14.26.4",
    "ky": "^2.0.2",
    "makeitaquote": "^8.0.1"
  }
}
